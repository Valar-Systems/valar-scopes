.pio/
.vscode/
__pycache__/
*.pyc

# Confidential business docs (pricing, margins, strategy) -- never commit to the public repo.
business/


# Manufacturing record written by scripts/provision-device.py: one row per board
# with its factory MAC and derived deviceId. Not a secret (the device KEY is never
# written anywhere), but it is customer-hardware data and a public-repo leak of the
# fleet roster -- keep it local. Override the location with --log if you want it
# somewhere else entirely.
provisioned.csv

# Everything the bench writes: per-run capture ledgers (scripts/bench-capture.ps1,
# the animation/game rigs -- one afternoon of tuning LIFTOFF left 25), capture pids,
# stock-firmware .bin dumps. Ignored as a whole directory: the per-pattern list
# missed new kinds and left dozens of untracked files that read as uncommitted
# work in `git status`. The historical soak logs already tracked here stay tracked
# (ignore rules never untrack a file); adding a new one needs `git add -f`. What
# survives a run is the numbers copied into docs/animtest-results-*.
bench-logs/

# wrangler local state (dev server, deploy cache) -- per-machine, never shared
.wrangler/

# Stray npm/vitest caches if a workspace command is ever run from the repo root
# (the real dependency trees live in proxy/ and dashboard/, ignored there).
node_modules/

# Operator scratch file for the revocation list (see src/revocation.ts).
# Fetched from KV, edited, put back -- never a source of truth, and it holds
# real device ids, so it does not belong in the repo.
proxy/revoked.txt

# Transient stderr capture from scripts/reconcile-fleet.py.
.reconcile-stderr.log
