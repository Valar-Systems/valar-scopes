{
  "name": "blipscope-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker edge proxy for Blipscope devices: /v1/blips, /v1/enrich, /v1/config",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "ingest": "tsx scripts/ingest-photos.ts",
    "ingest:check": "tsx scripts/ingest-photos.ts --check",
    "harvest": "tsx scripts/harvest-commons.ts",
    "ingest:mildb": "tsx scripts/ingest-mildb.ts",
    "ingest:planealert": "tsx scripts/ingest-planealert.ts",
    "ingest:airports": "tsx scripts/ingest-airports.ts",
    "ingest:routes": "tsx scripts/ingest-routes.ts",
    "derive-device-key": "tsx scripts/derive-device-key.ts",
    "dashboard": "tsx scripts/photo-dashboard.ts",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "tail:staging": "wrangler tail --env staging",
    "deploy:production": "bash scripts/deploy.sh production",
    "tail:production": "wrangler tail --env production",
    "ingest:typenames": "tsx scripts/ingest-typenames.ts",
    "photo-gaps": "tsx scripts/photo-gaps.ts",
    "verify:routes": "tsx scripts/verify-routes.ts",
    "stats": "tsx scripts/usage-stats.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20250906.0",
    "@types/node": "^26.2.0",
    "fflate": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "~3.2.0",
    "wrangler": "4.35.0"
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "workerd@1.20250906.0": true
  }
}
